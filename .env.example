# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==========================================
# 应用基础配置
# ==========================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ==========================================
# JWT 配置（必填）
# ==========================================
# 生成方法: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-key-at-least-32-characters-long-please-change-me
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# ==========================================
# 数据库配置
# ==========================================
# 开发环境可以留空（使用内存存储）
# 生产环境必须配置真实数据库
MONGODB_URI=mongodb://localhost:27017/marketbook
# 或 MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/marketbook

# ==========================================
# 邮件服务（用于邮箱验证）
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@marketbook.com

# Gmail 用户注意：
# 1. 开启"两步验证"
# 2. 生成"应用专用密码"：https://myaccount.google.com/apppasswords
# 3. 使用应用专用密码作为 SMTP_PASS

# ==========================================
# 行情数据配置
# ==========================================
# 运行模式：simulation（模拟数据，默认）| real（真实API）
MARKET_DATA_MODE=simulation

# Yahoo Finance（免费，无需API key，真实模式使用）
# 注意：Yahoo Finance API 无需注册，直接使用
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# 当前默认使用模拟行情数据，适合开发测试
# 生产环境建议设置 MARKET_DATA_MODE=real 接入真实行情

# ==========================================
# 安全配置
# ==========================================
# CORS 允许的来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting（请求频率限制）
RATE_LIMIT_WINDOW_MS=900000  # 15分钟
RATE_LIMIT_MAX=100           # 每个窗口最大请求数

# Session Secret（如果使用 express-session）
SESSION_SECRET=another-super-secret-key-for-sessions

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=info  # debug | info | warn | error

# ==========================================
# 错误监控（Sentry）
# ==========================================
# Sentry DSN（生产环境推荐）
# 获取方式：https://sentry.io/ 注册后创建项目，获取DSN
# 开发环境可不配置（可选）
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# 提示：
# - 生产环境必须配置 SENTRY_DSN 以监控错误
# - 开发环境不配置也不影响运行
# - 自动过滤敏感信息（密码、token等）

# ==========================================
# Redis 配置（可选，用于缓存/session）
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# 文件上传配置
# ==========================================
# 头像上传路径
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880  # 5MB (字节)

# ==========================================
# 第三方集成（可选）
# ==========================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ==========================================
# 模拟盘配置
# ==========================================
# 默认初始资金（美元）
DEFAULT_INITIAL_BALANCE=100000

# 交易手续费率（0.001 = 0.1%）
TRADING_FEE_RATE=0.001

# ==========================================
# 开发环境专用配置
# ==========================================
# 跳过邮箱验证（仅开发环境）
SKIP_EMAIL_VERIFICATION=true

# 使用宽松密码规则（仅开发环境）
RELAXED_PASSWORD_RULES=true

# 启用调试日志
DEBUG=marketbook:*

# ==========================================
# 生产环境提醒
# ==========================================
# 部署到生产环境前，请确保：
# 1. 修改所有 *_SECRET 为强随机字符串
# 2. 设置 NODE_ENV=production
# 3. 配置真实数据库 MONGODB_URI
# 4. 配置邮件服务（SMTP_*）
# 5. 关闭开发环境专用配置（SKIP_EMAIL_VERIFICATION、RELAXED_PASSWORD_RULES）
# 6. 配置真实行情API（ALPHA_VANTAGE_API_KEY 或其他）
# 7. 配置错误监控（SENTRY_DSN）
# 8. 设置 CORS_ORIGIN 为生产域名
# 9. 启用 HTTPS（推荐使用 Let's Encrypt）
# 10. 定期备份数据库

# ==========================================
# 快速开始（开发环境）
# ==========================================
# 1. 复制此文件为 .env
# 2. 修改 JWT_SECRET 为任意32字符以上的字符串
# 3. 其他配置保持默认即可（使用内存存储和模拟行情）
# 4. 运行 npm start

# 生成 JWT_SECRET:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
