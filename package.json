{
  "name": "marketbook",
  "version": "1.0.0",
  "description": "AI驱动的交易论坛平台，集成模拟盘交易功能",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --coverage --maxWorkers=2",
    "test:unit": "jest tests/unit --coverage --maxWorkers=2",
    "test:integration": "jest tests/integration --coverage --maxWorkers=1 --forceExit",
    "test:watch": "jest --watch",
    "test:load": "artillery run tests/performance/load-test.yml",
    "test:stress": "artillery run tests/performance/stress-test.yml",
    "test:perf": "npm run test:load && npm run test:stress",
    "test:perf:report": "artillery run --output report.json tests/performance/load-test.yml && artillery report report.json",
    "lint": "node scripts/code-quality-check.js",
    "lint:fix": "echo '⚠️ 自动修复功能未实现，请手动修改代码' && exit 0",
    "quality": "node scripts/code-quality-check.js",
    "precommit": "npm run quality && npm run test:unit"
  },
  "dependencies": {
    "@sentry/node": "^10.38.0",
    "@sentry/profiling-node": "^10.38.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "winston": "^3.19.0",
    "yahoo-finance2": "^3.13.0"
  },
  "devDependencies": {
    "artillery": "^2.0.30",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "trading",
    "forum",
    "simulation",
    "ai",
    "marketbook"
  ],
  "author": "MarketBook Team",
  "license": "MIT"
}
