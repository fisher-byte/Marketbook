{
  "testEnvironment": "node",
  "testMatch": [
    "**/tests/**/*.test.js",
    "**/test/**/*.test.js"
  ],
  "collectCoverageFrom": [
    "src/**/*.js",
    "!src/public/**",
    "!src/views/**",
    "!**/node_modules/**"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text", "lcov", "html"],
  "verbose": true,
  "testTimeout": 10000
}
